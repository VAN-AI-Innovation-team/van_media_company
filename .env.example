# media-outreach 백엔드(https://github.com/VAN-AI-Innovation/media-outreach) API 주소.
# 비워두면 배포된 Railway 백엔드(https://backend-production-2e28.up.railway.app)로 붙는다.
# 로컬 백엔드를 띄웠다면 .env.local로 복사해서 http://localhost:8080 등을 지정한다(.env.local은 *.local 패턴으로 git-ignore됨).
VITE_MEDIA_OUTREACH_API_URL=
# Browser requests use the Vite/Vercel same-origin proxy by default.
VITE_ARTICLE_API_BASE_URL=/api
# Target for local dev/preview proxy and build-time metadata fetches.
# Update vercel.json as well when changing the production backend.
ARTICLE_API_ORIGIN=https://press-media-recommendation-backend.onrender.com
SITE_URL=https://van-media-company.vercel.app
